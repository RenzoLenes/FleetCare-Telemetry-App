<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_normal">

        <!-- Connection Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectionStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_normal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/connectionStatusIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_bluetooth"
                    app:tint="@color/md_theme_light_primary"
                    android:contentDescription="@string/bluetooth_status" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_normal">

                    <TextView
                        android:id="@+id/connectionStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desconectado"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/firebaseSyncText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin sincronización"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/readDtcButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DTCs"
                    android:enabled="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Firebase Diagnostics Card (Expandable) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/firebaseDiagnosticsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/connectionStatusCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header (always visible) -->
                <LinearLayout
                    android:id="@+id/firebaseDiagnosticsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_normal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/firebaseDiagnosticsIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cloud_upload"
                        app:tint="@color/md_theme_light_tertiary"
                        android:contentDescription="@string/firebase_sync_status" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diagnóstico Firebase"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/firebaseDiagnosticsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toca para ver detalles"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_theme_light_onSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/firebaseDiagnosticsExpandIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="@color/md_theme_light_onSurfaceVariant"
                        android:contentDescription="Expandir" />

                </LinearLayout>

                <!-- Expanded Content (initially hidden) -->
                <LinearLayout
                    android:id="@+id/firebaseDiagnosticsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal"
                    android:visibility="gone">

                    <!-- Stats Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Total Attempts -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/totalAttemptsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_light_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Intentos"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        </LinearLayout>

                        <!-- Successful Writes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/successfulWritesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_light_tertiary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Exitosos"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        </LinearLayout>

                        <!-- Failed Writes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/failedWritesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_light_error" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fallidos"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Success Rate & Pending Queue -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tasa de éxito:"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                        <TextView
                            android:id="@+id/successRateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_small">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cola de pendientes:"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                        <TextView
                            android:id="@+id/pendingQueueValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 items"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Last Error -->
                    <TextView
                        android:id="@+id/lastErrorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Último error:"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_marginTop="@dimen/spacing_normal"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lastErrorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/md_theme_light_error"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_normal"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/testFirebaseButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_marginEnd="@dimen/spacing_small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resetStatsButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resetear"
                            style="@style/Widget.Material3.Button.TextButton" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Supported PIDs Card (Sprint 2) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/supportedPidsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/firebaseDiagnosticsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header (always visible) -->
                <LinearLayout
                    android:id="@+id/supportedPidsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_normal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/supportedPidsIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/md_theme_light_secondary"
                        android:contentDescription="PIDs Soportados" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PIDs Soportados"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/supportedPidsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toca para detectar PIDs"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_theme_light_onSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/supportedPidsExpandIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="@color/md_theme_light_onSurfaceVariant"
                        android:contentDescription="Expandir" />

                </LinearLayout>

                <!-- Expanded Content (initially hidden) -->
                <LinearLayout
                    android:id="@+id/supportedPidsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal"
                    android:visibility="gone">

                    <!-- Detect Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detectPidsButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detectar PIDs Soportados"
                        android:layout_marginBottom="@dimen/spacing_normal" />

                    <!-- Progress Indicator -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/detectPidsProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_normal"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <!-- RecyclerView for PID Categories -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/supportedPidsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- Empty State -->
                    <TextView
                        android:id="@+id/supportedPidsEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No hay PIDs detectados aún.\nToca el botón para detectar los PIDs soportados."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:textAlignment="center"
                        android:padding="@dimen/spacing_large"
                        android:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RPM Gauge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rpmCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/supportedPidsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/speedCard"
            app:layout_constraintWidth_percent="0.48">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RPM"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_theme_light_onSurfaceVariant" />

                <TextView
                    android:id="@+id/rpmValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_small" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/rpmProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    app:indicatorColor="@color/md_theme_light_primary"
                    android:max="8000"
                    android:progress="0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Speed Gauge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/speedCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:layout_marginStart="@dimen/spacing_small"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/supportedPidsCard"
            app:layout_constraintStart_toEndOf="@id/rpmCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.48">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal"
                    android:gravity="center"
                    android:rotationY="0">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Velocidad"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/md_theme_light_onSurfaceVariant" />

                <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_small" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/md_theme_light_onSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Temperature Section Title -->
        <TextView
            android:id="@+id/temperatureSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperaturas"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:layout_marginTop="@dimen/spacing_large"
            app:layout_constraintTop_toBottomOf="@id/rpmCard"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Coolant Temperature -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/coolantTempCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/temperatureSectionTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_normal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperatura del Refrigerante"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <TextView
                        android:id="@+id/coolantTempValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/coolantTempProgress"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:indicatorSize="60dp"
                    app:indicatorColor="@color/md_theme_light_primary"
                    android:max="150"
                    android:progress="0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Engine Section Title -->
        <TextView
            android:id="@+id/engineSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motor"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:layout_marginTop="@dimen/spacing_large"
            app:layout_constraintTop_toBottomOf="@id/coolantTempCard"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Engine Load -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/engineLoadCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/engineSectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/throttlePositionCard"
            app:layout_constraintWidth_percent="0.48">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carga del Motor"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_theme_light_onSurfaceVariant" />

                <TextView
                    android:id="@+id/engineLoadValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_small" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/engineLoadProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    app:indicatorColor="@color/md_theme_light_secondary"
                    android:max="100"
                    android:progress="0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Throttle Position -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/throttlePositionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:layout_marginStart="@dimen/spacing_small"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/engineSectionTitle"
            app:layout_constraintStart_toEndOf="@id/engineLoadCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.48">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Posición del Acelerador"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/md_theme_light_onSurfaceVariant" />

                <TextView
                        android:id="@+id/throttlePositionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_small" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/throttlePositionProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:indicatorColor="@color/md_theme_light_secondary"
                        android:max="100"
                        android:progress="0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Additional Parameters Grid -->
        <LinearLayout
            android:id="@+id/additionalParamsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_normal"
            app:layout_constraintTop_toBottomOf="@id/engineLoadCard">

            <!-- Voltage & Fuel Level Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_small"
                    app:cardElevation="@dimen/elevation_card"
                    app:cardCornerRadius="@dimen/corner_radius_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voltaje"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            android:id="@+id/voltageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_small"
                    app:cardElevation="@dimen/elevation_card"
                    app:cardCornerRadius="@dimen/corner_radius_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nivel de Combustible"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            android:id="@+id/fuelLevelValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Other Temps Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_small">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_small"
                    app:cardElevation="@dimen/elevation_card"
                    app:cardCornerRadius="@dimen/corner_radius_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temp. Admisión"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            android:id="@+id/intakeAirTempValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_small"
                    app:cardElevation="@dimen/elevation_card"
                    app:cardCornerRadius="@dimen/corner_radius_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temp. Ambiente"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            android:id="@+id/ambientTempValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Universal Scanner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/universalScannerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            app:cardElevation="@dimen/elevation_card"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:layout_constraintTop_toBottomOf="@id/additionalParamsLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Universal PID Scanner"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escanea todos los PIDs soportados por tu vehículo"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_theme_light_onSurfaceVariant"
                    android:layout_marginBottom="@dimen/spacing_normal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUniversalScanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iniciar Escaneo"
                        android:enabled="false"
                        style="@style/Widget.Material3.Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVehicleProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Perfil"
                        android:enabled="false"
                        android:layout_marginStart="@dimen/spacing_small"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
